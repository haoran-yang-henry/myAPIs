# Cloud Run settings for this service, read by scripts/deploy.sh.
MEMORY=512Mi
CPU=1
# Ingesting a long document embeds all of its chunks within the request.
TIMEOUT=120s
CONCURRENCY=40
MIN_INSTANCES=0
MAX_INSTANCES=2
# Plain env vars, comma-separated KEY=VALUE.
ENV_VARS=ENV=prod,LOG_LEVEL=INFO
# Secret Manager refs, comma-separated ENV_VAR=secret-name:version.
SECRETS=API_KEYS=myapis-api-keys:latest,OPENAI_API_KEY=myapis-openai-key:latest,DATABASE_URL=myapis-knowledge-db-url:latest
