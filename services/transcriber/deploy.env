# Cloud Run settings for this service, read by scripts/deploy.sh.
# ffmpeg and the transcoded pieces live in memory (Cloud Run's /tmp is RAM).
MEMORY=2Gi
CPU=1
# Requests themselves are short (part uploads, polling); transcription runs in the background.
TIMEOUT=300s
CONCURRENCY=8
MIN_INSTANCES=0
# Exactly one instance: jobs run inside the process, and the storage mount caches
# file metadata per instance.
MAX_INSTANCES=1
# Plain env vars, comma-separated KEY=VALUE.
ENV_VARS=ENV=prod,LOG_LEVEL=INFO,DATA_DIR=/mnt/data
# Secret Manager refs, comma-separated ENV_VAR=secret-name:version.
SECRETS=API_KEYS=myapis-api-keys:latest,OPENAI_API_KEY=myapis-openai-key:latest
# Keep CPU allocated after responses so background transcription isn't throttled,
# and mount the bucket at /mnt/data, owned by the container's user (uid/gid 1000).
EXTRA_FLAGS=(
  --no-cpu-throttling
  "--add-volume=name=data,type=cloud-storage,bucket=${GCP_PROJECT}-transcriber,mount-options=uid=1000;gid=1000"
  --add-volume-mount=volume=data,mount-path=/mnt/data
)
