# Cloud Run settings for this service, read by scripts/deploy.sh.
MEMORY=512Mi
CPU=1
TIMEOUT=60s
# Max concurrent requests per instance; lower it for CPU-heavy work.
CONCURRENCY=80
MIN_INSTANCES=0
# Hard cap on instances, which also caps cost.
MAX_INSTANCES=2
# Plain env vars, comma-separated KEY=VALUE.
ENV_VARS=ENV=prod,LOG_LEVEL=INFO
# Secret Manager refs, comma-separated ENV_VAR=secret-name:version.
SECRETS=API_KEYS=myapis-api-keys:latest
