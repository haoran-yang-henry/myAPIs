# Copy to .env for local development. Never commit .env.
ENV=local
LOG_LEVEL=INFO
# Keys accepted in the X-API-Key header, comma-separated; each is name:key or a bare key.
# Empty disables auth, which is only allowed when ENV=local.
API_KEYS=

# --- transcriber ---
# openai, or fake to get placeholder text without calling any API.
ASR_PROVIDER=openai
OPENAI_API_KEY=
# Default language hints and keywords, comma-separated, e.g. zh-cn,en
ASR_LANGUAGES=
ASR_KEYWORDS=

# --- knowledge ---
# Uses OPENAI_API_KEY above. openai, or fake to embed locally without an API.
EMBEDDING_PROVIDER=openai
# Defaults to the postgres container in docker-compose.yml (docker compose up -d postgres).
# DATABASE_URL=postgresql://knowledge:knowledge@localhost:5434/knowledge
